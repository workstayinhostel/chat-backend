MONGO_HOST=your-cluster.mongodb.net
MONGO_DATABASE=chatapp
MONGO_APP_NAME=metufy
# Optional: comma-separated DNS server IPs if Node cannot resolve MongoDB SRV records.
MONGO_DNS_SERVERS=
dbuser=your_database_user
dbpassword=your_database_password
JWT_SECRET=generate-a-random-secret-at-least-32-characters
ENC_KEY=generate-64-hex-characters
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
ORIGIN=http://192.168.1.83:8000,http://localhost:8000
PORT=4000
